{
  "name": "@cfai/video-compare",
  "version": "1.0.4",
  "description": "WebAssembly library for real-time image frame comparison (SSIM/PSNR/MSE)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "browser": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/video-compare.js": "./dist/video-compare.js",
    "./dist/video-compare.wasm": "./dist/video-compare.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash build.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "image",
    "video",
    "comparison",
    "ssim",
    "psnr",
    "mse",
    "image-processing",
    "similarity"
  ],
  "author": "video-compare contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drunkenQCat/video-compare.git",
    "directory": "npm-package"
  },
  "bugs": {
    "url": "https://github.com/drunkenQCat/video-compare/issues"
  },
  "homepage": "https://github.com/drunkenQCat/video-compare#readme",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": true
}
