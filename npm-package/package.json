{
  "name": "@video-compare/wasm",
  "version": "1.0.0",
  "description": "WebAssembly library for real-time image frame comparison (SSIM/PSNR/MSE)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "browser": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:bundle": "rollup -c",
    "test": "jest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "image",
    "video",
    "comparison",
    "ssim",
    "psnr",
    "mse",
    "image-processing",
    "similarity"
  ],
  "author": "video-compare contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drunkenQCat/video-compare.git",
    "directory": "npm-package"
  },
  "bugs": {
    "url": "https://github.com/drunkenQCat/video-compare/issues"
  },
  "homepage": "https://github.com/drunkenQCat/video-compare#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false
}
